{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"], "strict": true, "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "skipLibCheck": true,
    "esModuleInterop": true, "resolveJsonModule": true, "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
